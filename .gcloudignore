# What `gcloud builds submit` leaves out of the source upload. Starts from
# .gitignore so local secrets (.env*) and build artifacts stay out, then adds
# what is only noise for an image build. .gitignore's bare `server` was
# anchored to the repo root so that pkg/server is no longer dropped.
#!include:.gitignore
.git/
.gcloudignore
site/
temp/
**/node_modules/
**/dist/
**/.terraform/
